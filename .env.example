# ---------------------------------------------------------------------------
# NileGPU — environment configuration
# Copy this file to `.env.local` for local development and configure the same
# variables in your hosting provider for production. Never commit real keys.
# ---------------------------------------------------------------------------

# Supabase project URL, e.g. https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Public anonymous key. Reserved for future read-only, RLS-protected client
# queries; the current frontend does not use it because anonymous database
# access is denied by design. Still required for a complete Supabase setup.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only key used by POST /api/wishlist to insert applications.
# NEVER expose this to the browser or client components.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Absolute site URL used for canonical links, sitemap and Open Graph metadata.
# Falls back to the Vercel URL, then http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public contact address shown in the footer, privacy notice and review screen.
NEXT_PUBLIC_CONTACT_EMAIL=wishlist@nilegpu.com

# Optional analytics sink. When set, anonymous product events are POSTed here
# (names, emails and survey answers are never included). Leave empty to disable.
NEXT_PUBLIC_ANALYTICS_ENDPOINT=

# Optional distributed rate limiting (Upstash Redis REST API). Without these the
# endpoint uses a per-instance in-memory limiter, which is not production-safe
# across multiple serverless instances. See README for details.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
